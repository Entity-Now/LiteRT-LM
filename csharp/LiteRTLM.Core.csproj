<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auto-copy native library built by Bazel if it exists in the bin directory -->
    <None Condition="Exists('..\bazel-bin\csharp\libCLiteRTLM.dylib')" Include="..\bazel-bin\csharp\libCLiteRTLM.dylib" CopyToOutputDirectory="PreserveNewest" Link="libCLiteRTLM.dylib" />
    <None Condition="Exists('..\bazel-bin\csharp\libCLiteRTLM.so')" Include="..\bazel-bin\csharp\libCLiteRTLM.so" CopyToOutputDirectory="PreserveNewest" Link="libCLiteRTLM.so" />
    <None Condition="Exists('..\bazel-bin\csharp\libCLiteRTLM.dll')" Include="..\bazel-bin\csharp\libCLiteRTLM.dll" CopyToOutputDirectory="PreserveNewest" Link="CLiteRTLM.dll" />

    <!-- GPU backends dynamically load these LiteRT runtime libraries at engine initialization. -->
    <None Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\prebuilt\macos_arm64\libLiteRt.dylib')" Include="..\prebuilt\macos_arm64\libLiteRt.dylib" CopyToOutputDirectory="PreserveNewest" Link="libLiteRt.dylib" />
    <None Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\prebuilt\macos_arm64\libLiteRtWebGpuAccelerator.dylib')" Include="..\prebuilt\macos_arm64\libLiteRtWebGpuAccelerator.dylib" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtWebGpuAccelerator.dylib" />
    <None Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\prebuilt\macos_arm64\libLiteRtTopKWebGpuSampler.dylib')" Include="..\prebuilt\macos_arm64\libLiteRtTopKWebGpuSampler.dylib" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtTopKWebGpuSampler.dylib" />
    <None Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\prebuilt\macos_arm64\libwebgpu_dawn.dylib')" Include="..\prebuilt\macos_arm64\libwebgpu_dawn.dylib" CopyToOutputDirectory="PreserveNewest" Link="libwebgpu_dawn.dylib" />
    <None Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\prebuilt\macos_arm64\libLiteRtMetalAccelerator.dylib')" Include="..\prebuilt\macos_arm64\libLiteRtMetalAccelerator.dylib" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtMetalAccelerator.dylib" />
    <None Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\prebuilt\macos_arm64\libLiteRtTopKMetalSampler.dylib')" Include="..\prebuilt\macos_arm64\libLiteRtTopKMetalSampler.dylib" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtTopKMetalSampler.dylib" />
    <None Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\prebuilt\macos_arm64\libGemmaModelConstraintProvider.dylib')" Include="..\prebuilt\macos_arm64\libGemmaModelConstraintProvider.dylib" CopyToOutputDirectory="PreserveNewest" Link="libGemmaModelConstraintProvider.dylib" />

    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64') And Exists('..\prebuilt\linux_x86_64\libLiteRt.so')" Include="..\prebuilt\linux_x86_64\libLiteRt.so" CopyToOutputDirectory="PreserveNewest" Link="libLiteRt.so" />
    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64') And Exists('..\prebuilt\linux_x86_64\libLiteRtWebGpuAccelerator.so')" Include="..\prebuilt\linux_x86_64\libLiteRtWebGpuAccelerator.so" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtWebGpuAccelerator.so" />
    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64') And Exists('..\prebuilt\linux_x86_64\libLiteRtTopKWebGpuSampler.so')" Include="..\prebuilt\linux_x86_64\libLiteRtTopKWebGpuSampler.so" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtTopKWebGpuSampler.so" />
    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64') And Exists('..\prebuilt\linux_x86_64\libwebgpu_dawn.so')" Include="..\prebuilt\linux_x86_64\libwebgpu_dawn.so" CopyToOutputDirectory="PreserveNewest" Link="libwebgpu_dawn.so" />
    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64') And Exists('..\prebuilt\linux_x86_64\libGemmaModelConstraintProvider.so')" Include="..\prebuilt\linux_x86_64\libGemmaModelConstraintProvider.so" CopyToOutputDirectory="PreserveNewest" Link="libGemmaModelConstraintProvider.so" />

    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(RuntimeIdentifier)' == 'linux-arm64' And Exists('..\prebuilt\linux_arm64\libLiteRt.so')" Include="..\prebuilt\linux_arm64\libLiteRt.so" CopyToOutputDirectory="PreserveNewest" Link="libLiteRt.so" />
    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(RuntimeIdentifier)' == 'linux-arm64' And Exists('..\prebuilt\linux_arm64\libLiteRtWebGpuAccelerator.so')" Include="..\prebuilt\linux_arm64\libLiteRtWebGpuAccelerator.so" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtWebGpuAccelerator.so" />
    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(RuntimeIdentifier)' == 'linux-arm64' And Exists('..\prebuilt\linux_arm64\libLiteRtTopKWebGpuSampler.so')" Include="..\prebuilt\linux_arm64\libLiteRtTopKWebGpuSampler.so" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtTopKWebGpuSampler.so" />
    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(RuntimeIdentifier)' == 'linux-arm64' And Exists('..\prebuilt\linux_arm64\libwebgpu_dawn.so')" Include="..\prebuilt\linux_arm64\libwebgpu_dawn.so" CopyToOutputDirectory="PreserveNewest" Link="libwebgpu_dawn.so" />
    <None Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(RuntimeIdentifier)' == 'linux-arm64' And Exists('..\prebuilt\linux_arm64\libGemmaModelConstraintProvider.so')" Include="..\prebuilt\linux_arm64\libGemmaModelConstraintProvider.so" CopyToOutputDirectory="PreserveNewest" Link="libGemmaModelConstraintProvider.so" />

    <None Condition="$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64') And Exists('..\prebuilt\windows_x86_64\libLiteRt.dll')" Include="..\prebuilt\windows_x86_64\libLiteRt.dll" CopyToOutputDirectory="PreserveNewest" Link="libLiteRt.dll" />
    <None Condition="$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64') And Exists('..\prebuilt\windows_x86_64\libLiteRtWebGpuAccelerator.dll')" Include="..\prebuilt\windows_x86_64\libLiteRtWebGpuAccelerator.dll" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtWebGpuAccelerator.dll" />
    <None Condition="$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64') And Exists('..\prebuilt\windows_x86_64\libLiteRtTopKWebGpuSampler.dll')" Include="..\prebuilt\windows_x86_64\libLiteRtTopKWebGpuSampler.dll" CopyToOutputDirectory="PreserveNewest" Link="libLiteRtTopKWebGpuSampler.dll" />
    <None Condition="$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64') And Exists('..\prebuilt\windows_x86_64\libwebgpu_dawn.dll')" Include="..\prebuilt\windows_x86_64\libwebgpu_dawn.dll" CopyToOutputDirectory="PreserveNewest" Link="libwebgpu_dawn.dll" />
    <None Condition="$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64') And Exists('..\prebuilt\windows_x86_64\libGemmaModelConstraintProvider.dll')" Include="..\prebuilt\windows_x86_64\libGemmaModelConstraintProvider.dll" CopyToOutputDirectory="PreserveNewest" Link="libGemmaModelConstraintProvider.dll" />
  </ItemGroup>
</Project>
